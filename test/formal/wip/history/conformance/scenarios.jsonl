{"name": "W_LateTimedOut", "tag": "adversarial", "why": "a timed-out copy's late unlabeled echo arrives while a same-text copy waits", "steps": [{"send": {"i": 1, "tgt": "chan", "cmd": "PRIVMSG", "txt": "a"}}, {"send": {"i": 2, "tgt": "chan", "cmd": "PRIVMSG", "txt": "a"}}, {"timeout": 1}, {"line": {"raw": ":{me}!u@h PRIVMSG {chan} :a", "m": {"k": "echo", "lab": "none", "txt": "a", "tgt": "chan", "cmd": "PRIVMSG", "id": 0, "ref": 0, "bt": "none", "who": 1, "role": "late"}}}, {"line": {"raw": "@label={L2} :{me}!u@h PRIVMSG {chan} :a", "m": {"k": "echo", "lab": "L2", "txt": "a", "tgt": "chan", "cmd": "PRIVMSG", "id": 0, "ref": 0, "bt": "none", "who": 2, "role": "resp"}}}], "labels": true}
