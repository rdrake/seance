{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "testRunnerNodeArgs": ["--import", "tsx"],
  "mochaOptions": {
    "config": "test/.mocharc.yml",
    "spec": ["test/**/*.ts"],
    "ignore": [
      "test/e2e/**",
      "test/public/**",
      "test/tests/build.ts",
      "test/**/*.live.ts",
      "test/scenes/ps/legibility.ts"
    ]
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "client/js/**/*.ts",
    "shared/**/*.ts",
    "!**/*.d.ts",
    "!client/js/**/emoji-catalog*",
    "!client/js/scenes/**",
    "!client/js/settings.ts",
    "!client/js/configuration.ts"
  ],
  "ignorePatterns": ["tmp", "public", "attic", "android", "ios", "reports", "test/public"],
  "reporters": ["html", "json", "progress"],
  "concurrency": 6,
  "timeoutMS": 10000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
